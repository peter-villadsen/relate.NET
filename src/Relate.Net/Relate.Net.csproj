<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Relate.Net</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package -->
    <PackageId>Relate.Net</PackageId>
    <Version>1.0.0</Version>
    <Description>Community, idiomatic .NET wrapper for Relate (https://github.com/relatedb/relate), the embedded property-graph database with a Cypher query language. Bundles the unmodified relate $(RelateNativeVersion) native library (Apache-2.0) for Windows x64. Not affiliated with the Relate authors or Neo4j.</Description>
    <PackageTags>relate;graph;database;cypher;neo4j;embedded</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/peter-villadsen/relate.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peter-villadsen/relate.NET.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Source Link (built into the .NET 8+ SDK) + symbol package for debugging into the library. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)docs\UserGuide.md" Pack="true" PackagePath="docs" Visible="false" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build\RelateNative.targets" />

</Project>
